s None:\n","            continue\n","        lab_p0 = np.asarray(p0[\"labels\"]).astype(int)\n","        s = _agree(scored, lab_p0) #compare to score or not score\n","\n","        long_rows.append({\n","            \"weight_class\": wc,\n","            \"method\"      : name,\n","            \"config\"      : \"P0\",\n","            \"n\"           : len(lab_p0),\n","            \"retained_n\"  : int((lab_p0 != -1).sum()),\n","            \"k\"           : _k(p0),\n","            \"silhouette\"  : p0[\"silhouette\"],\n","            \"dbi\"         : p0[\"dbi\"],\n","            \"delta_sil\"   : 0.0,\n","\n","            # reference row: comparing P0 with itself is not informative\n","            \"ARI_vs_P0_cond\" : np.nan, \"ARI_vs_P0_cov\": np.nan, \"ARI_vs_P0_ret\": np.nan,\n","\n","            \"ARI_scored_cond\": s[\"cond\"], \"ARI_scored_cov\": s[\"cov\"], \"ARI_scored_ret\": s[\"ret\"],\n","\n","            \"coverage\"       : s[\"coverage\"],\n","        })\n","\n","        for cfg in SENS_CONFIGS:\n","            sel  = sens_selected[cfg][wc][name]\n","            rows = prepared[wc][cfg][\"rows\"]\n","            if sel is None:\n","                long_rows.append({\"weight_class\": wc, \"method\": name, \"config\": cfg,\n","                                  \"n\": int(rows.sum()), \"k\": np.nan})\n","                continue\n","            lab = np.asarray(sel[\"labels\"]).astype(int) #label for TP, NT, SO\n","\n","            p = _agree(lab_p0[rows], lab)\n","\n","            #if not SO\n","            s = _agree(scored[rows], lab) if cfg != \"SO\" else {\"cond\": np.nan, \"cov\": np.nan, \"ret\": np.nan}\n","\n","            long_rows.append({\n","                \"weight_class\": wc,\n","                \"method\": name,\n","                \"config\": cfg,\n","                \"n\": int(rows.sum()),\n","                \"retained_n\": int((lab != -1).sum()),\n","                \"k\": _k(sel),\n","                \"silhouette\": sel[\"silhouette\"],\n","                \"dbi\": sel[\"dbi\"],\n","\n","                # computed from unrounded values (rounded only for display)\n","                \"delta_sil\": sel[\"silhouette\"] - p0[\"silhouette\"],\n","                \"ARI_vs_P0_cond\": p[\"cond\"], \"ARI_vs_P0_cov\": p[\"cov\"], \"ARI_vs_P0_ret\": p[\"ret\"],\n","\n","                # undefined for SO: every observation there scored\n","                \"ARI_scored_cond\": s[\"cond\"], \"ARI_scored_cov\": s[\"cov\"], \"ARI_scored_ret\": s[\"ret\"],\n","\n","                \"coverage\": p[\"coverage\"],\n","            })\n","\n","zero_long = pd.DataFrame(long_rows)"],"metadata":{"id":"yn1ordqjR5GG"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["zero_long[zero_long.method == 'DBSCAN']"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":445},"id":"UxwOf02Hfnu3","executionInfo":{"status":"ok","timestamp":1791706339991,"user_tz":-420,"elapsed":164,"user":{"displayName":"Derry Alamsyah","userId":"16456265919386018795"}},"outputId":"54f58823-7f9a-4bf3-cc1a-9a3bbef74324"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["   weight_class  method config   n  retained_n    k  silhouette       dbi  \\\n","16  Female-42kg  DBSCAN     P0  38        33.0  3.0    0.476823  0.807292   \n","17  Female-42kg  DBSCAN     TP  38        31.0  2.0    0.339315  0.973755   \n","18  Female-42kg  DBSCAN     NT  38        32.0  2.0    0.432320  0.706300   \n","19  Female-42kg  DBSCAN     SO  24        20.0  2.0    0.248099  1.234756   \n","36  Female-47kg  DBSCAN     P0  38        31.0  2.0    0.364185  0.881601   \n","37  Female-47kg  DBSCAN     TP  38         NaN  NaN         NaN       NaN   \n","38  Female-47kg  DBSCAN     NT  38         NaN  NaN         NaN       NaN   \n","39  Female-47kg  DBSCAN     SO  29         NaN  NaN         NaN       NaN   \n","56  Female-54kg  DBSCAN     P0  38        31.0  2.0    0.487445  0.740023   \n","57  Female-54kg